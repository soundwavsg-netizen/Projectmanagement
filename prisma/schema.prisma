// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("Admin") // Admin, Manager, Client
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String    @id @default(cuid())
  name        String
  client      String
  description String?
  status      String    @default("Planning") // Planning, InProgress, Review, Complete
  startDate   DateTime
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]
  comments    Comment[]
  files       File[]
  activities  Activity[]
}

model Task {
  id             String           @id @default(cuid())
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  assignee       String           // Clawdbot, Claude, ChatGPT, Gemini, Perplexity, Human
  status         String           @default("Todo") // Todo, InProgress, Review, Done
  priority       String           @default("Medium") // High, Medium, Low
  estimatedHours Float?
  actualHours    Float?
  dueDate        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  dependencies   TaskDependency[] @relation("DependentTask")
  blockedBy      TaskDependency[] @relation("BlockingTask")
}

model TaskDependency {
  id              String @id @default(cuid())
  dependentTaskId String
  blockingTaskId  String
  dependentTask   Task   @relation("DependentTask", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  blockingTask    Task   @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)

  @@unique([dependentTaskId, blockingTaskId])
}

model Comment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    String
  content   String
  createdAt DateTime @default(now())
}

model File {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename   String
  filepath   String
  filesize   Int
  mimeType   String
  uploadedBy String
  uploadedAt DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action    String   // Created, Updated, Deleted, StatusChanged, etc.
  entity    String   // Project, Task, Comment
  entityId  String?
  details   String?
  actor     String
  createdAt DateTime @default(now())
}
